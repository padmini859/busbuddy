# ===================================================================
# BusBuddy — Environment Configuration Template
# Copy this file to .env and adjust variables as needed
# ===================================================================

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=busbuddy_db
MYSQL_USER=root
MYSQL_PASSWORD=root

# Backend Security
JWT_SECRET=busbuddy_super_secure_jwt_secret_token_key_2026_at_least_256_bits_long_for_security
JWT_EXPIRATION_MS=86400000

# Backend Server
SERVER_PORT=8080

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api
